<!--
  CyberDog navigation BT — replan while following, robust recovery.

  Based on navigation/nav_bringup reference BT, adapted for quadruped:
  - PipelineSequence: plan + follow run concurrently
  - RateController 2Hz: replan periodically (lower than reference 3Hz for Orin NX)
  - Spin kept but at reduced angle (0.78rad ~45deg) — full 90deg risks IMU drift on quadruped
  - BackUp conservative for legged robot
  - Higher retry counts for robustness
-->
<root BTCPP_format="3" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RecoveryNode name="NavigateRecovery" number_of_retries="10">

      <PipelineSequence name="NavigateWithReplanning">

        <RateController hz="2.0">
          <RecoveryNode name="ComputePathToPose" number_of_retries="5">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode name="FollowPath" number_of_retries="8">
          <FollowPath path="{path}" controller_id="MPPIController"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <BackUp backup_dist="0.20" backup_speed="0.10" time_allowance="3.0"/>
          <Spin spin_dist="0.78"/>
        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>

  </BehaviorTree>
</root>
