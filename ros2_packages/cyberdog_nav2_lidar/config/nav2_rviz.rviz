Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Cell Size: 1
      Line Style:
        Value: Lines
      Color: 100; 100; 100
      Plane: XY
      Plane Cell Count: 40

    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 5
      Frames:
        All Enabled: true
      Update Interval: 0
      Tree:
        {}

    - Class: rviz_default_plugins/Map
      Name: Cartographer Map
      Value: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Use Timestamp: false
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (raw)
      Value: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 50; 50
      Size (m): 0.03
      Style: Points
      Queue Size: 1
      Decay Time: 0
      Selectable: true

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (fixed)
      Value: true
      Topic:
        Value: /scan_fixed
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 0; 200; 255
      Size (m): 0.04
      Style: Points
      Queue Size: 1
      Decay Time: 0
      Selectable: true

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Value: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Use Timestamp: false
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Value: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Use Timestamp: false
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Path
      Name: Global Path
      Value: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
      Width: 0.03
      Alpha: 1.0
      Pose Style: None

    - Class: rviz_default_plugins/Path
      Name: Local Trajectory
      Value: true
      Topic:
        Value: /local_plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Line Style: Lines
      Width: 0.02
      Alpha: 0.8

    - Class: rviz_default_plugins/Marker
      Name: MPPI Trajectories
      Value: true
      Topic:
        Value: /MPPIController/trajectories
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Polygon
      Name: Global Footprint
      Value: true
      Topic:
        Value: /global_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 170; 255

    - Class: rviz_default_plugins/Polygon
      Name: Local Footprint
      Value: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 170; 0

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose

  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Distance: 20
      Near Clip Distance: 0.01
      X: 0
      Y: 0
      Angle: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1200
  X: 0
  Y: 0
