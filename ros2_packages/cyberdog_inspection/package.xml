<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cyberdog_inspection</name>
  <version>0.1.0</version>
  <description>Single-device inspection adapter for CyberDog Nav2 using the existing MSTC core.</description>

  <maintainer email="dev@cyberdog.local">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <build_depend>libgrpc++-dev</build_depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>libprotobuf-dev</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>
  <build_depend>nlohmann-json3-dev</build_depend>
  <build_depend>protobuf-compiler</build_depend>
  <build_depend>protobuf-compiler-grpc</build_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
